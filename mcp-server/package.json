{
  "name": "wisp-mcp",
  "version": "0.1.0",
  "description": "MCP server wrapping Wisp's public API — lets an agent ask for a DID's signal or the active room list directly.",
  "license": "MIT",
  "author": "erhnysr",
  "homepage": "https://wisp-watch.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erhnysr/wisp.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "mcp",
    "technocore",
    "flop",
    "did",
    "tclk",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "wisp-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@flop-labs/tclk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
